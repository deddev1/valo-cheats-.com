---
import en from '../../public/locales/en/translation.json';

const h = en.home;
---

<section class="shell home__prose home__prose--en home-about" aria-labelledby="home-about-title">
	<h2 id="home-about-title" class="home-about__title">{h.aboutTitle}</h2>
	<p class="home-about__lede">{h.aboutP1}</p>
	<p class="home-about__links">
		{h.aboutP2Before}{' '}
		<a href="/valorant-cheats/">{h.aboutPillar}</a>,{' '}
		<a href="/valorant-esp/">{h.aboutEsp}</a>,{' '}
		<a href="/valorant-aimbot/">{h.aboutAimbot}</a>, or{' '}
		<a href="/updates/">{h.aboutUndetected}</a>.
	</p>
</section>

<style>
	.home-about {
		border-left: 3px solid var(--accent);
		padding-left: 1rem;
		margin-top: 0.75rem;
	}

	.home-about__title {
		margin: 0 0 0.75rem;
		font-family: var(--font-display);
		font-size: 1.125rem;
		font-weight: 700;
		line-height: 1.35;
		letter-spacing: -0.02em;
		color: var(--ink);
		text-wrap: balance;
		text-rendering: optimizeLegibility;
		-webkit-font-smoothing: antialiased;
	}

	.home-about__lede {
		margin: 0 0 0.75rem;
		color: #d6d6de;
		line-height: 1.7;
		text-wrap: pretty;
	}

	.home-about__links {
		margin: 0;
		color: #b8b8c0;
		line-height: 1.65;
		text-wrap: pretty;
	}

	.home-about__links a {
		color: var(--accent);
		font-weight: 600;
		text-decoration: underline;
		text-decoration-color: color-mix(in srgb, var(--accent) 40%, transparent);
		text-underline-offset: 0.15em;
	}

	.home-about__links a:hover {
		color: var(--accent-hover);
		text-decoration-color: var(--accent-hover);
	}
</style>
